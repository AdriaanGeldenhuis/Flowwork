<?xml version="1.0" encoding="utf-8"?>
<!--
   FlowDrive orange adaptive-icon background: a diagonal gradient whose visible 72dp
   window runs from #FF9828 (top-left) to #D6540A (bottom-right). The matching
   rasters come from app files/tools/icons/make_icons.py.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#FFFFA930"
                android:endColor="#FFCC4303" />
        </aapt:attr>
    </path>
</vector>
