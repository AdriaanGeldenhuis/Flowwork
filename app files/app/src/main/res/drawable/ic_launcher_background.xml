<?xml version="1.0" encoding="utf-8"?>
<!--
   Shared adaptive-icon background for FlowWork, FlowMail and FlowDrive:
   the brand's diagonal purple gradient. The ends are set so the visible
   72dp window matches the logo tile (#7C2EA6 top-left to #2F0461
   bottom-right). Regenerate the matching rasters with
   app files/tools/icons/make_icons.py.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#FF8F39B7"
                android:endColor="#FF1C0050" />
        </aapt:attr>
    </path>
</vector>
