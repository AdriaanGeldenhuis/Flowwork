<?xml version="1.0" encoding="utf-8"?><!--
   Backup / device-transfer rules for API 31+.
   The flowdrive.xml preferences file holds the user's FlowDrive
   sign-in details and must never leave the device in a backup
   or a device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="flowdrive.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="flowdrive.xml"/>
    </device-transfer>
</data-extraction-rules>
